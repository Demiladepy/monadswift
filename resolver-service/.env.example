# Loaded automatically via dotenv when you run `pnpm dev` (from resolver-service/).
#
# Same Privy app as the frontend (Dashboard → App settings → App secret)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Local SQLite via libSQL (create folder once: mkdir data)
TURSO_DATABASE_URL=file:./data/resolver.db

# Hosted Turso instead of file: (then set token from `turso db tokens create`)
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# Optional: allow your Vite dev origin (comma-separated). Default * is fine for local testing.
# CORS_ORIGIN=http://localhost:5173

# Port (default 8787)
# PORT=8787
