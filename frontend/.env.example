# Privy (client: publishable app id; server-only secret must not ship to browser in production)
PRIVY_APP_ID=
PRIVY_SECRET_KEY=

# Network: omit or `testnet` (default). Set to `mainnet` for production.
VITE_MONAD_NETWORK=testnet

# Kuru REST (markets / trades). In pnpm dev, default is Vite proxy /kuru-api/api/v3 (avoids CORS).
# VITE_KURU_REST_BASE=https://exchange.kuru.io/api/v3
# Kuru Flow (quotes + JWT) — override if needed for your environment.
# VITE_KURU_FLOW_BASE=https://ws.kuru.io/api
# Kuru pool indexer for SDK PathFinder (markets/filtered). Default: https://exchange.kuru.io
# VITE_KURU_POOL_API_BASE=https://exchange.kuru.io


# MoonPay — optional; fiat onramp is disabled in app code until you re-enable it.
# PUBLIC_MOONPAY_API_KEY=

# Send by email / @handle — static JSON map (checked first; keys case-insensitive). No server needed.
# VITE_RECIPIENT_RESOLVER_MAP={"friend@test.com":"0x742d35Cc6634C0532925a3b844Bc454e4438f44e","@alice":"0x742d35Cc6634C0532925a3b844Bc454e4438f44e"}
# Optional: HTTP resolver GET ?q= → JSON { "address": "0x..." }
# VITE_RECIPIENT_RESOLVER_URL=https://your-api.example.com/resolve
# Optional: on-chain registry resolve(string) → address
# VITE_RECIPIENT_REGISTRY_ADDRESS=0x...
