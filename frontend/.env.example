# Privy (client: publishable app id; server-only secret must not ship to browser in production)
PRIVY_APP_ID=
PRIVY_SECRET_KEY=

# MoonPay — publishable key from https://dashboard.moonpay.com (same as "public" / widget key)
PUBLIC_MOONPAY_API_KEY=

# Use https://buy-sandbox.moonpay.com while integrating (omit or false for production)
PUBLIC_MOONPAY_SANDBOX=false

# Optional — must match currency/network codes in your MoonPay dashboard for Monad
PUBLIC_MOONPAY_NETWORK_CODE=monad
PUBLIC_MOONPAY_CURRENCY_MON=mon
PUBLIC_MOONPAY_CURRENCY_USDC=usdc
PUBLIC_MOONPAY_QUOTE_AMOUNT_MON=50
PUBLIC_MOONPAY_QUOTE_AMOUNT_USDC=50

# You can use VITE_* or NEXT_PUBLIC_* names instead of PUBLIC_* — see vite.config.ts
